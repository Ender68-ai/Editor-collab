{
    "geode": "5.9.0",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "d050.multiplayeredit",
    "name": "Multiplayer Edit",
    "version": "v0.5.2",
    "developer": "d050",
    "description": "Collaborate with friends in real-time level editing! Host a session and build together.",
    "dependencies": {
        "geode.node-ids": ">=1.0.0"
    },
    "tags": [
        "editor",
        "online",
        "enhancement",
        "utility",
        "interface",
        "content"
    ],
    "links": {
        "community": "https://discord.com/users/499203269504008202",
        "source": "https://github.com/xXoanon/MultiplayerEdit",
        "homepage": "https://d050.vercel.app/"
    },
    "issues": {
        "info": "Please report any bugs or crashes on the GitHub issues page.",
        "url": "https://github.com/xXoanon/MultiplayerEdit/issues"
    },
    "settings": {
        "connection-section": {
            "type": "title",
            "name": "Connection Settings"
        },
        "signaling-url": {
            "type": "string",
            "name": "Signaling Server URL",
            "description": "URL of the signaling server used for connection setup. Only change this if you're self-hosting your own signaling server.",
            "default": "https://dewy-flea-9364.d050.deno.net",
            "max-length": 150,
            "filter": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789:/.?&=-_"
        },
        "player-name": {
            "type": "string",
            "name": "Player Name",
            "description": "Your display name in multiplayer sessions. Leave empty to automatically use your username.",
            "default": ""
        },
        "display-section": {
            "type": "title",
            "name": "Display"
        },
        "show-cursors": {
            "type": "bool",
            "name": "Show Player Cursors",
            "description": "Display other players' cursor positions in the editor.",
            "default": true
        },
        "show-notifications": {
            "type": "bool",
            "name": "Show Notifications",
            "description": "Show notifications when players join/leave.",
            "default": true
        }
    }
}