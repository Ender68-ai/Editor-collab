{
    "geode": "5.9.0",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "ender68.multiplayeredit",
    "name": "Multiplayer Edit",
    "version": "v0.6.0",
    "developer": "d050",
    "description": "Collaborate with friends in real-time level editing.",
    "dependencies": {
        "geode.node-ids": ">=v1.21.0",
        "alphalaneous.alphas_geode_utils": ">=v1.2.5"
    },
    "tags": [
        "editor", "online", "enhancement", "interface"
    ],
    "resources": {
        "sprites": [
            "resources/backbtn.png",
            "resources/button.png",
            "resources/button2.png",
            "resources/crosshair.png",
            "resources/cursor.png",
            "resources/settingsbtn.png",
            "resources/online.png",
            "resources/offline.png"
        ]
    },
    "settings": {
        "connection-section": {
            "type": "title",
            "name": "Connection Settings"
        },
        "signaling-url": {
            "type": "string",
            "name": "Signaling Server URL",
            "description": "URL of the signaling server used for connection setup. Only change this if you're self-hosting your own signaling server.",
            "default": "https://dewy-flea-9364.d050.deno.net",
            "filter": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789:/.?&=-_"
        },
        "player-name": {
            "type": "string",
            "name": "Player Name",
            "description": "Your display name in multiplayer sessions. Leave empty to automatically use your username.",
            "default": "",
            "match": "^.{0,15}$"
        },
        "display-section": {
            "type": "title",
            "name": "Display"
        },
        "show-cursors": {
            "type": "bool",
            "name": "Show Player Cursors",
            "description": "Display other players' cursor positions in the editor.",
            "default": true
        },
        "show-notifications": {
            "type": "bool",
            "name": "Show Notifications",
            "description": "Show notifications when players join/leave.",
            "default": true
        },
        "check-updates": {
            "type": "bool",
            "name": "Check for Updates",
            "description": "Automatically check for newer versions when opening the Multiplayer menu.",
            "default": true
        }
    }
}