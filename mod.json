{
    "geode": "5.8.2",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "ender68.collabeditor",
    "name": "CollabEditor",
    "version": "0.1.0",
    "developers": ["Ender", "cipmtrews", "d050"],
    "links": {
        "source": "https://github.com/Ender68-ai/Editor-collab"
    },
    "description": "Multiplayer editor for Geometry Dash.",
    "dependencies": {
        "geode.node-ids": ">=v1.21.0",
        "hjfod.gmd-api": ">=v1.5.0",
        "imes.git-editor": ">=v1.0.0-beta.13"
    },
    "tags": [
        "editor", "online", "enhancement", "interface", "enhancement"
    ],
    "resources": {
        "sprites": [
            "resources/backbtn.png",
            "resources/button.png",
            "resources/button2.png",
            "resources/crosshair.png",
            "resources/cursor.png",
            "resources/settingsbtn.png"
        ]
    },
    "issues": {
        "info": "Message me in discord, ender.68 is my username."
    },
    "settings": {
        "connection-section": {
            "type": "title",
            "name": "Connection Settings"
        },
        "signaling-url": {
            "type": "string",
            "name": "Signaling Server URL",
            "description": "URL of the signaling server used for connection setup. Only change this if you're self-hosting your own signaling server.",
            "default": "https://dewy-flea-9364.d050.deno.net",
            "max-length": 150,
            "filter": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789:/.?&=-_"
        },
        "player-name": {
            "type": "string",
            "name": "Player Name",
            "description": "Your display name in multiplayer sessions.",
            "default": "Player"
        },
        "display-section": {
            "type": "title",
            "name": "Display"
        },
        "show-cursors": {
            "type": "bool",
            "name": "Show Player Cursors",
            "description": "Display other players' cursor positions in the editor.",
            "default": true
        },
        "show-notifications": {
            "type": "bool",
            "name": "Show Notifications",
            "description": "Show notifications when players join/leave.",
            "default": true
        },
        "max-players": {
            "type": "int",
            "default": 8,
            "min": 2,
            "max": 16,
            "name": "Max Players",
            "description": "Maximum players allowed when hosting a room",
            "control": {
                "slider": true
            }
        }
    }
}